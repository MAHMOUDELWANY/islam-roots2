# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# Supabase Client Configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase Server Admin Configuration (server-only; never prefix with VITE_)
SUPABASE_SERVICE_ROLE_KEY=

# Server-only bootstrap identity for the first super administrator.
# Do not expose this value in client code or VITE_ variables.
SUPER_ADMIN_EMAIL=

# Google OAuth Configuration (For Google Workspace integrations)
VITE_GOOGLE_CLIENT_ID=
