{
  "entities": {
    "teachers": {
      "title": "teachers",
      "description": "Teacher profiles",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "name", "email"]
    },
    "students": {
      "title": "students",
      "description": "Student profiles owned by teacher",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "teacherId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "age": { "type": "number" },
        "nationality": { "type": "string" },
        "nativeLanguage": { "type": "string" },
        "learningLanguage": { "type": "string" },
        "level": { "type": "string" },
        "subjects": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "teacherId", "name"]
    },
    "curriculums": {
      "title": "curriculums",
      "description": "Curriculums owned by teacher",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "teacherId": { "type": "string" },
        "name": { "type": "string" },
        "subject": { "type": "string" },
        "description": { "type": "string" },
        "level": { "type": "string" },
        "lessons": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "teacherId", "name", "subject"]
    },
    "studentCurriculums": {
      "title": "studentCurriculums",
      "description": "Student curriculum assignments",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "teacherId": { "type": "string" },
        "studentId": { "type": "string" },
        "curriculumId": { "type": "string" },
        "startedAt": { "type": "string" },
        "currentLessonId": { "type": "string" },
        "completedLessonIds": { "type": "array", "items": { "type": "string" } },
        "progressPercentage": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "teacherId", "studentId", "curriculumId"]
    },
    "lessonSessions": {
      "title": "lessonSessions",
      "description": "Recorded lesson sessions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "teacherId": { "type": "string" },
        "studentId": { "type": "string" },
        "curriculumId": { "type": "string" },
        "lessonId": { "type": "string" },
        "lessonTitleSnapshot": { "type": "string" },
        "date": { "type": "string" },
        "duration": { "type": "number" },
        "attendanceStatus": { "type": "string" },
        "objectives": { "type": "array", "items": { "type": "string" } },
        "completedItems": { "type": "array", "items": { "type": "string" } },
        "teacherNotes": { "type": "string" },
        "homework": { "type": "string" },
        "quizScore": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "teacherId", "studentId"]
    },
    "progressRecords": {
      "title": "progressRecords",
      "description": "Historical student progress tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "teacherId": { "type": "string" },
        "studentId": { "type": "string" },
        "curriculumId": { "type": "string" },
        "lessonId": { "type": "string" },
        "date": { "type": "string" },
        "completed": { "type": "boolean" },
        "progressPercentage": { "type": "number" },
        "notes": { "type": "string" }
      },
      "required": ["id", "teacherId", "studentId"]
    },
    "memoryDetectiveSessions": {
      "title": "memoryDetectiveSessions",
      "description": "Quran Memory Detective sessions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "teacherId": { "type": "string" },
        "studentId": { "type": "string" },
        "surahId": { "type": "number" },
        "verseRange": { "type": "string" },
        "questionCount": { "type": "number" },
        "difficulty": { "type": "string" },
        "score": { "type": "number" },
        "startedAt": { "type": "string" },
        "completedAt": { "type": "string" }
      },
      "required": ["id", "teacherId", "studentId"]
    },
    "savedAIContent": {
      "title": "savedAIContent",
      "description": "Saved AI Lesson plans, quizzes, homework",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "teacherId": { "type": "string" },
        "studentId": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "object" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "teacherId", "type", "title"]
    }
  }
}
